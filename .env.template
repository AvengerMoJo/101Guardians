# Flask configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your_secret_key_here
FLASK_RUN_PORT=5000 


# Google OAuth credentials
# Get these from Google Cloud Console (https://console.cloud.google.com/)
# by creating an OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# LINE Login credentials
# Get these from LINE Developers Console (https://developers.line.biz/)
# by creating a new channel with the LINE Login feature enabled
LINE_CLIENT_ID=your_line_client_id_here
LINE_CLIENT_SECRET=your_line_client_secret_here

# Database configuration
DATABASE_PATH=app.db
